    "reader",
    "naturalizer",
    "support",
    "ai_disclosure",
    "final_preflight",
    "process_freezer"
  ],
  "review_lenses": {
    "substantive": {"stage": "paper_review", "timing": "post_draft"},
    "claim_evidence": {"stage": "claim_evidence", "timing": "pre_draft"},
    "terminology": {"stage": "terminology", "timing": "pre_draft"},
    "figure_table": {"stage": "figure_table", "timing": "pre_draft"},
    "ai_pattern": {"stage": "ai_pattern", "timing": "post_draft"},
    "anti_homogenization": {"stage": "anti_homogenization", "timing": "post_draft"},
    "reader_experience": {"stage": "reader", "timing": "post_draft"}
  },
  "stages": {
    "rules_profile": {"skill": "modeling-rules-profile", "depends_on": [], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "foundation", "notes": "规则是合规依据；在不作合规结论的探索阶段可以稍后核验。"},
    "topic_selection": {"skill": "modeling-topic-selection", "depends_on": [], "recommended_after": ["rules_profile"], "human_gate": "required", "gate_type": "core_decision", "phase": "foundation", "notes": "规则影响赛事取舍时应优先核对；已有人类选题或早期比较不必被规则资料阻断。"},
    "literature_evidence": {"skill": "modeling-literature-evidence", "depends_on": ["topic_selection"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "familiarization", "notes": "Use orientation mode before formal problem intake; citation-audit may be rerun later."},
    "problem_familiarization": {"skill": "modeling-problem-familiarization", "depends_on": ["literature_evidence", "topic_selection"], "human_gate": "required", "gate_type": "core_decision", "phase": "familiarization"},
    "problem_intake": {"skill": "modeling-problem-intake", "depends_on": ["problem_familiarization", "topic_selection"], "human_gate": "required", "gate_type": "core_decision", "phase": "interpretation"},
    "distinctiveness_coach": {"skill": "modeling-distinctiveness-coach", "depends_on": ["problem_intake", "problem_familiarization"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "modeling", "notes": "写前保留题目锚点，不强行制造新颖性；未完成时可先写保守草稿。"},
    "assumption_ledger": {"skill": "modeling-assumption-ledger", "depends_on": ["problem_intake", "problem_familiarization"], "human_gate": "required", "gate_type": "core_decision", "phase": "modeling"},
    "data_audit": {"skill": "modeling-data-audit", "depends_on": ["problem_intake", "problem_familiarization"], "human_gate": "required", "gate_type": "core_decision", "phase": "modeling"},
    "model_architect": {"skill": "modeling-model-architect", "depends_on": ["problem_intake", "problem_familiarization", "distinctiveness_coach", "assumption_ledger", "data_audit"], "human_gate": "required", "gate_type": "core_decision", "phase": "modeling"},
    "experiment_validator": {"skill": "modeling-experiment-validator", "depends_on": ["model_architect"], "human_gate": "required", "gate_type": "core_decision", "phase": "validation"},
    "paper_architect": {"skill": "modeling-paper-architect", "depends_on": ["problem_intake", "model_architect", "experiment_validator"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "writing", "notes": "蓝图是写作辅助，不应把论文写作锁死在固定章节。"},
    "figure_design": {"skill": "modeling-figure-designer", "depends_on": ["paper_architect", "experiment_validator"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "writing"},
    "figure_table": {"skill": "modeling-figure-table-auditor", "depends_on": ["experiment_validator", "figure_design"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "claim_evidence": {"skill": "modeling-claim-evidence-audit", "depends_on": ["paper_architect", "experiment_validator"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "terminology": {"skill": "modeling-terminology-auditor", "depends_on": ["paper_architect"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "draft": {"skill": "modeling-paper-writer", "depends_on": [], "recommended_after": ["paper_architect", "experiment_validator", "figure_design", "figure_table", "claim_evidence", "terminology"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "writing", "notes": "已有题面、分析或旧稿时可直接形成证据范围明确的暂定稿；结构、实验、图表和术语检查是推荐前置，不应阻断用户明确要求的续写。"},
    "paper_review": {"skill": "modeling-paper-reviewer", "depends_on": ["draft"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "ai_pattern": {"skill": "modeling-ai-pattern-reviewer", "depends_on": ["draft"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "anti_homogenization": {"skill": "modeling-anti-homogenization-auditor", "depends_on": ["draft", "distinctiveness_coach"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "reader": {"skill": "modeling-reader-experience-auditor", "depends_on": ["draft"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "audit"},
    "naturalizer": {"skill": "modeling-paper-naturalizer", "depends_on": ["draft"], "recommended_after": ["paper_review", "ai_pattern", "anti_homogenization", "reader"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "revision", "notes": "没有专项报告时仍可做保守的成文清洁，但不得声称已完成全套审查。"},
    "support": {"skill": "modeling-support-materials-auditor", "depends_on": ["draft"], "recommended_after": ["figure_table"], "human_gate": "optional", "gate_type": "review_checkpoint", "phase": "delivery"},
    "ai_disclosure": {"skill": "modeling-ai-use-disclosure", "depends_on": ["rules_profile"], "human_gate": "required", "gate_type": "core_decision", "phase": "compliance"},
    "final_preflight": {"skill": "modeling-final-preflight", "depends_on": ["naturalizer", "support", "ai_disclosure"], "recommended_after": ["paper_review", "ai_pattern", "anti_homogenization", "reader", "figure_table", "claim_evidence", "terminology"], "human_gate": "required", "gate_type": "core_decision", "phase": "delivery"},
    "process_freezer": {"skill": "modeling-process-freezer", "depends_on": ["final_preflight"], "human_gate": "required", "gate_type": "core_decision", "phase": "delivery"}
  }
}
