{
  "schema_version": "0.2",
  "description": "Canonical stage IDs, hard dependencies, soft recommendations, gate types and review-lens map for the default MathModelingSkills workflow.",
  "default_order": [
    "rules_profile",
    "topic_selection",
    "literature_evidence",
    "problem_familiarization",
