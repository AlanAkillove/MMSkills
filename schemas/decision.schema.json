{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlanAkillove/MMSkills/schemas/decision.schema.json",
  "title": "Human decision record",
  "type": "object",
  "required": [
    "decision_id",
    "stage",
    "decision_topic",
    "candidates",
    "adopted_option",
    "decision_maker",
    "evidence_ids",
    "status",
    "reasoning",
    "reversal_conditions"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "at": {"type": "string"},
    "stage": {"type": "string"},
    "decision_topic": {"type": "string"},
    "candidates": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "adopted_option": {"type": ["string", "null"]},
    "decision_maker": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pending", "confirmed", "rejected", "superseded", "unknown"]},
    "reasoning": {"type": "string"},
    "reversal_conditions": {"type": "array", "items": {"type": "string"}},
    "affected_artifacts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
