{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlanAkillove/MMSkills/schemas/pipeline-state.schema.json",
  "title": "MathModelingSkills pipeline state",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "mode",
    "entry_status",
    "current_stage",
    "stages",
    "artifacts",
    "gates",
    "open_issues",
    "event_log",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["compose", "revise", "audit", "disclose", "final_check"]},
    "run_profile": {"enum": ["research-full", "contest-standard", "contest-fast"]},
    "collaboration_mode": {"enum": ["adaptive", "light", "standard", "full"]},
    "working_depth": {"enum": ["light", "standard", "full"]},
    "user_intent": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"enum": ["understand", "explore", "select_topic", "literature", "model", "experiment", "draft", "revise", "audit", "disclose", "final_check", "release", "unknown"]},
        "action": {"enum": ["explain", "explore", "propose", "execute_reversible", "adopt", "freeze", "submit"]},
        "requested_stage": {"type": ["string", "null"]},
        "scope": {"enum": ["question", "subproblem", "section", "paper", "project", "unknown"]},
        "urgency": {"enum": ["low", "normal", "high", "unknown"]},
        "allow_provisional_output": {"type": "boolean"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selected_lenses": {
      "type": "array",
      "items": {
        "enum": [
          "substantive",
          "claim_evidence",
          "terminology",
          "figure_table",
          "ai_pattern",
          "anti_homogenization",
          "reader_experience"
        ]
      },
      "uniqueItems": true
    },
    "entry_status": {"enum": ["confirmed", "ambiguous", "unknown"]},
    "current_stage": {"type": "string", "minLength": 1},
    "stages": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "skill": {"type": "string"},
            "status": {
              "enum": [
                "not_started",
                "ready",
                "in_progress",
                "needs_human",
                "passed",
                "blocked",
                "stale",
                "skipped",
                "superseded"
              ]
            },
            "depends_on": {"type": "array", "items": {"type": "string"}},
            "inputs": {"type": "array", "items": {"type": "string"}},
            "outputs": {"type": "array", "items": {"type": "string"}},
            "human_gate": {"enum": ["required", "optional", "not_applicable"]},
            "gate_type": {"enum": ["core_decision", "review_checkpoint", "none"]},
            "human_status": {
              "enum": ["unreviewed", "needs-human-confirmation", "human-confirmed", "rejected", "unknown"]
            },
            "decision_id": {"type": ["string", "null"]},
            "last_run_at": {"type": ["string", "null"]},
            "source_snapshot_id": {"type": ["string", "null"]},
            "evidence_status": {"enum": ["confirmed", "partial", "unknown", "conflict"]},
            "decision_ids": {"type": "array", "items": {"type": "string"}},
            "issue_ids": {"type": "array", "items": {"type": "string"}},
            "reason": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "status"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "status": {"enum": ["present", "missing", "stale", "unknown"]},
          "sha256": {"type": ["string", "null"]},
          "produced_by": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "gates": {"type": "array", "items": {"type": "object"}},
    "open_issues": {"type": "array", "items": {"type": "string"}},
    "last_snapshot_id": {"type": ["string", "null"]},
    "event_log": {"type": "array", "items": {"type": "object"}},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
