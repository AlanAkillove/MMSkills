{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlanAkillove/MMSkills/schemas/stage-registry.schema.json",
  "title": "MathModelingSkills canonical pipeline stage registry",
  "type": "object",
  "required": ["schema_version", "default_order", "stages"],
  "properties": {
    "schema_version": {"type": "string"},
    "description": {"type": "string"},
    "default_order": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["skill", "depends_on", "human_gate", "phase"],
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "human_gate": {"enum": ["required", "optional", "not_applicable"]},
          "phase": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
