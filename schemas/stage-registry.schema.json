{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlanAkillove/MMSkills/schemas/stage-registry.schema.json",
  "title": "MathModelingSkills canonical pipeline stage registry",
  "type": "object",
  "required": ["schema_version", "default_order", "stages", "review_lenses", "default_action_gates"],
  "properties": {
    "schema_version": {"type": "string"},
    "description": {"type": "string"},
    "action_levels": {
      "type": "array",
      "items": {
        "enum": ["explain", "explore", "propose", "execute_reversible", "adopt", "freeze", "submit"]
      },
      "uniqueItems": true
    },
    "default_action_gates": {
      "type": "object",
      "required": ["core_decision", "review_checkpoint", "none"],
      "properties": {
        "core_decision": {"$ref": "#/$defs/actionGateMap"},
        "review_checkpoint": {"$ref": "#/$defs/actionGateMap"},
        "none": {"$ref": "#/$defs/actionGateMap"}
      },
      "additionalProperties": false
    },
    "default_order": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "review_lenses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["stage", "timing"],
        "properties": {
          "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "timing": {"enum": ["pre_draft", "post_draft"]}
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["skill", "execution_requires", "human_gate", "gate_type", "phase"],
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "execution_requires": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "adoption_requires": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "recommended_after": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "uniqueItems": true
          },
          "depends_on": {
            "description": "Deprecated alias of execution_requires; if present it must match.",
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "action_gates": {"$ref": "#/$defs/actionGateOverlay"},
          "human_gate": {"enum": ["required", "optional", "not_applicable"]},
          "gate_type": {"enum": ["core_decision", "review_checkpoint", "none"]},
          "phase": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "actionGateValue": {"enum": ["none", "optional", "required"]},
    "actionGateMap": {
      "type": "object",
      "required": ["explain", "explore", "propose", "execute_reversible", "adopt", "freeze", "submit"],
      "properties": {
        "explain": {"$ref": "#/$defs/actionGateValue"},
        "explore": {"$ref": "#/$defs/actionGateValue"},
        "propose": {"$ref": "#/$defs/actionGateValue"},
        "execute_reversible": {"$ref": "#/$defs/actionGateValue"},
        "adopt": {"$ref": "#/$defs/actionGateValue"},
        "freeze": {"$ref": "#/$defs/actionGateValue"},
        "submit": {"$ref": "#/$defs/actionGateValue"}
      },
      "additionalProperties": false
    },
    "actionGateOverlay": {
      "type": "object",
      "properties": {
        "explain": {"$ref": "#/$defs/actionGateValue"},
        "explore": {"$ref": "#/$defs/actionGateValue"},
        "propose": {"$ref": "#/$defs/actionGateValue"},
        "execute_reversible": {"$ref": "#/$defs/actionGateValue"},
        "adopt": {"$ref": "#/$defs/actionGateValue"},
        "freeze": {"$ref": "#/$defs/actionGateValue"},
        "submit": {"$ref": "#/$defs/actionGateValue"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
